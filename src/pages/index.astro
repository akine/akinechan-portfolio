  <!-- Language Toggle Script -->
  <script>
    const langToggle = document.getElementById('lang-toggle');
    const savedLang = localStorage.getItem('portfolio-lang');
    let currentLang = savedLang === 'en' ? 'en' : 'ja';

    // 初期表示
    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.lang = currentLang;
      if (langToggle) {
        langToggle.textContent = currentLang === 'ja' ? 'English' : '日本語';
      }
      document.querySelectorAll('[data-en][data-ja]').forEach(el => {
        const text = el.getAttribute(`data-${currentLang}`);
        if (text) {
          el.textContent = text;
        }
      });
    });

    langToggle?.addEventListener('click', () => {
      currentLang = currentLang === 'ja' ? 'en' : 'ja';
      langToggle.textContent = currentLang === 'ja' ? 'English' : '日本語';
      document.documentElement.lang = currentLang;
      localStorage.setItem('portfolio-lang', currentLang);
      
      document.querySelectorAll('[data-en][data-ja]').forEach(el => {
        const text = el.getAttribute(`data-${currentLang}`);
        if (text) {
          el.textContent = text;
        }
      });
    });

    // EXILE Gallery Slider
    (() => {
      const slides = document.getElementById('exile-slides');
      const dots = document.querySelectorAll('.exile-dot');
      const prev = document.getElementById('exile-prev');
      const next = document.getElementById('exile-next');
      if (!slides) return;
      let current = 0;
      const total = dots.length;
      
      const goTo = (i: number) => {
        current = ((i % total) + total) % total;
        slides.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, idx) => {
          (d as HTMLElement).style.opacity = idx === current ? '0.9' : '0.4';
        });
      };
      
      prev?.addEventListener('click', () => goTo(current - 1));
      next?.addEventListener('click', () => goTo(current + 1));
      dots.forEach(d => d.addEventListener('click', () => goTo(Number((d as HTMLElement).dataset.index))));
      
      // Touch swipe support
      let startX = 0;
      slides.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
      slides.addEventListener('touchend', (e) => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
      });
      
      // Auto-advance every 5s
      let timer = setInterval(() => goTo(current + 1), 5000);
      slides.parentElement?.addEventListener('mouseenter', () => clearInterval(timer));
      slides.parentElement?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 5000); });
    })();

    // 🥚 Easter Egg
    const avatar = document.getElementById('avatar');
    const avatarCard = document.getElementById('avatar-card');
    let clickCount = 0;
    let clickTimer: ReturnType<typeof setTimeout> | null = null;
    const messages = [
      '🎬 Action!', '📹 Rolling!', '✂️ Good cut!', '🎥 Wrap!', '💡',
      '🎮 GG!', '🐂 アリスター！', '🥋 ジェイミー！', '🦞', '🍻', '💖', '✨',
      '(´・ω・｀)', '( ˘ω˘ )', '٩( \'ω\' )و', '🦐 エビじゃないよ',
      'ちゅむ 💕', '(´∀`) ぬるぽ'
    ];

    // 四方八方からの曲線パターン
    const getRandomPath = (rect: DOMRect) => {
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const r = rect.width / 2;
      
      const patterns = [
        // 右上へ「ノ」
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 60, y: cy - 20 }, end: { x: cx + r + 40, y: cy - r - 40 } },
        // 左上へ逆「ノ」
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 60, y: cy - 20 }, end: { x: cx - r - 40, y: cy - r - 40 } },
        // 右下へ
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 60, y: cy + 20 }, end: { x: cx + r + 50, y: cy + r + 30 } },
        // 左下へ
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 60, y: cy + 20 }, end: { x: cx - r - 50, y: cy + r + 30 } },
        // 真上へ
        { start: { x: cx, y: cy - r * 0.5 }, mid: { x: cx + 30, y: cy - r - 30 }, end: { x: cx, y: cy - r - 60 } },
        // 真上へ（逆カーブ）
        { start: { x: cx, y: cy - r * 0.5 }, mid: { x: cx - 30, y: cy - r - 30 }, end: { x: cx, y: cy - r - 60 } },
        // 右へ
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 40, y: cy - 30 }, end: { x: cx + r + 80, y: cy } },
        // 左へ
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 40, y: cy - 30 }, end: { x: cx - r - 80, y: cy } },
      ];
      
      return patterns[Math.floor(Math.random() * patterns.length)];
    };

    const spawnEasterEgg = (forceMsg?: string, targetPos?: {x: number, y: number}) => {
      const rect = avatar!.getBoundingClientRect();
      const msg = forceMsg || messages[Math.floor(Math.random() * messages.length)];
      const path = getRandomPath(rect);
      
      // ｶﾞｯの場合はぬるぽの位置に被せる
      const isGatsu = msg === '⊂彡☆))Д´) ｶﾞｯ';
      const endPos = targetPos || path.end;
      
      const toast = document.createElement('div');
      toast.textContent = msg;
      toast.style.cssText = `
        position: fixed;
        left: ${path.start.x}px;
        top: ${path.start.y}px;
        transform: translate(-50%, -50%) scale(0);
        background: ${isGatsu ? '#ef4444' : 'white'};
        color: ${isGatsu ? 'white' : '#334155'};
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 600;
        z-index: ${isGatsu ? 41 : 40};
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        border: 2px solid ${isGatsu ? '#dc2626' : '#e2e8f0'};
        white-space: nowrap;
        pointer-events: none;
      `;

      document.body.appendChild(toast);
      
      // ぬるぽが出たら自動でｶﾞｯ（少しズラして被せる）
      if (msg === '(´∀`) ぬるぽ') {
        const gatsuPos = { x: endPos.x + 15, y: endPos.y - 20 };
        setTimeout(() => spawnEasterEgg('⊂彡☆))Д´) ｶﾞｯ', gatsuPos), 400);
      }

      // スッと出て、止まって見せて、ふわっと消える
      toast.animate([
        { 
          left: `${path.start.x}px`, 
          top: `${path.start.y}px`, 
          transform: 'translate(-50%, -50%) scale(0.5)', 
          opacity: 0,
          offset: 0
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1.05)', 
          opacity: 1,
          offset: 0.15
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1)', 
          opacity: 1,
          offset: 0.25
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1)', 
          opacity: 1,
          offset: 0.75
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y - 15}px`, 
          transform: 'translate(-50%, -50%) scale(0.9)', 
          opacity: 0,
          offset: 1
        }
      ], {
        duration: 2500,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      }).onfinish = () => toast.remove();
    };

    avatar?.addEventListener('click', () => {
      clickCount++;
      
      if (clickTimer) clearTimeout(clickTimer);
      clickTimer = setTimeout(() => { clickCount = 0; }, 2000);

      // 5回ごとに発動（5, 10, 15, ...）- 連打OK、同時に複数出る
      if (clickCount % 5 === 0) {
        // 少しランダムな遅延で同時感を出す
        setTimeout(() => spawnEasterEgg(), Math.random() * 100);
      }
    });

    let targetPx = 0.5;
    let targetPy = 0.5;
    let currentPx = 0.5;
    let currentPy = 0.5;
    let currentScale = 1;
    let wobble = 0;
    let wobblePhase = 0;
    let avatarRaf: number | null = null;
    let isAvatarHovering = false;
    let lastFrameTime: number | null = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const runAvatarAnimation = (now: number) => {
      if (!avatarCard) return;
      // 60Hzでも120Hzでも同じ速度になるよう経過時間ベースで補間
      const dt = lastFrameTime === null ? 16.7 : Math.min(now - lastFrameTime, 50);
      lastFrameTime = now;
      const posEase = 1 - Math.exp(-dt / 110);
      const scaleEase = 1 - Math.exp(-dt / 90);
      const wobbleEase = 1 - Math.exp(-dt / 150);

      currentPx += (targetPx - currentPx) * posEase;
      currentPy += (targetPy - currentPy) * posEase;
      currentScale += ((isAvatarHovering ? 1.05 : 1) - currentScale) * scaleEase;

      const drift = Math.abs(targetPx - currentPx) + Math.abs(targetPy - currentPy);
      const targetWobble = isAvatarHovering ? Math.min(drift * 10, 1.2) : 0;
      wobble += (targetWobble - wobble) * wobbleEase;
      wobblePhase += dt * 0.011;

      // 位置追従 + ほんの少し遅れて揺れる（うねうね感）
      const rx = (currentPy - 0.5) * 10 + Math.sin(wobblePhase) * wobble;
      const ry = -(currentPx - 0.5) * 10 + Math.cos(wobblePhase * 0.9) * wobble;

      avatarCard.style.setProperty('--rx', `${rx.toFixed(3)}deg`);
      avatarCard.style.setProperty('--ry', `${ry.toFixed(3)}deg`);
      avatarCard.style.setProperty('--mx', `${(currentPx * 100).toFixed(2)}%`);
      avatarCard.style.setProperty('--my', `${(currentPy * 100).toFixed(2)}%`);
      avatarCard.style.setProperty('--sc', currentScale.toFixed(4));

      const settled = drift < 0.001 && wobble < 0.005 && Math.abs(currentScale - 1) < 0.001;
      if (isAvatarHovering || !settled) {
        avatarRaf = requestAnimationFrame(runAvatarAnimation);
      } else {
        avatarCard.style.setProperty('--rx', '0deg');
        avatarCard.style.setProperty('--ry', '0deg');
        avatarCard.style.setProperty('--sc', '1');
        avatarRaf = null;
        lastFrameTime = null;
      }
    };

    const startAvatarAnimation = () => {
      if (prefersReducedMotion) return;
      if (avatarRaf === null) {
        lastFrameTime = null;
        avatarRaf = requestAnimationFrame(runAvatarAnimation);
      }
    };

    avatarCard?.addEventListener('mouseenter', () => {
      isAvatarHovering = true;
      startAvatarAnimation();
    });

    avatarCard?.addEventListener('mousemove', (e) => {
      if (!avatarCard) return;
      const rect = avatarCard.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      targetPx = Math.min(Math.max(x / rect.width, 0), 1);
      targetPy = Math.min(Math.max(y / rect.height, 0), 1);
      startAvatarAnimation();
    });

    avatarCard?.addEventListener('mouseleave', () => {
      isAvatarHovering = false;
      targetPx = 0.5;
      targetPy = 0.5;
      startAvatarAnimation();
    });

    // スクロールに合わせてセクションがふわっと現れる
    if (!prefersReducedMotion && 'IntersectionObserver' in window) {
      const revealEls = document.querySelectorAll('section h2, section h3, section .grid, #faq .space-y-4');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => {
        el.classList.add('reveal');
        revealObserver.observe(el);
      });
    }
  </script>
</Layout>
