---
import Layout from '../layouts/Layout.astro';
import Text from '../components/Text.astro';
import { Image } from 'astro:assets';
import {
  works,
  otherWorks,
  services,
  email,
  mailto,
  mailtoEn,
} from '../data/portfolio';
import avatar from '../assets/avatar.png';
import exile from '../assets/exile-tour-thumb.jpg';
import neon from '../assets/exile-tour-neon-city.jpg';
import title from '../assets/exile-tour-title.jpg';
import wontbelong from '../assets/exile-tour-wontbelong.jpg';
import vfx from '../assets/tiktok-vfx.jpg';
import steak from '../assets/ai-art/ai-steak.png';
import kitchen from '../assets/ai-art/ai-kitchen.png';
import washoku from '../assets/ai-art/ai-washoku.png';
import caramel from '../assets/ai-art/ai-caramel.png';
import cheesecake from '../assets/ai-art/ai-cheesecake.png';
const navigation = [
  { id: 'works', ja: '制作実績', en: 'Work' },
  { id: 'skills', ja: 'できること', en: 'Services' },
  { id: 'lab', ja: 'AI・開発', en: 'AI & Dev' },
  { id: 'about', ja: 'プロフィール', en: 'About' },
];
const gallery = [
  { image: exile, alt: 'WON’T BE LONG — ネオンの街とクラシックカー' },
  { image: neon, alt: 'ドームステージの複数面スクリーン向け映像レイアウト' },
  { image: title, alt: 'EXILE LIVE TOUR — タイトルビジュアル' },
  { image: wontbelong, alt: 'WON’T BE LONG — ステージ映像の別カット' },
];
---

<Layout title="小城昭根 | 映像ディレクター・編集・AI開発 | Kojo Akine">
  <a class="skip-link" href="#main">
    <Text ja="本文へスキップ" en="Skip to content" />
  </a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="/" aria-label="Kojo Akine — Home">
        akine<span class="brand-dot">.</span>
      </a>
      <nav class="desktop-nav" aria-label="Main">
        {navigation.map((link) => (
          <a href={`#${link.id}`}>
            <Text {...link} />
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <button id="lang-toggle" class="language-button" type="button" hidden>
          English
        </button>
        <a class="contact-nav" href="#contact">
          <Text ja="仕事の相談" en="Let’s talk" />
          <span aria-hidden="true">↗</span>
        </a>
        <button
          id="menu-toggle"
          class="menu-button"
          type="button"
          aria-label="メニューを開く"
          aria-expanded="false"
          aria-controls="mobile-menu"
          hidden
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" aria-label="Mobile" hidden>
      {navigation.map((link) => (
        <a href={`#${link.id}`}>
          <Text {...link} />
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-topline">
        <span class="eyebrow">INDEPENDENT CREATIVE / JAPAN</span>
        <span class="availability">
          <i aria-hidden="true"></i>
          <Text ja="お仕事のご相談、受付中" en="Open to project inquiries" />
        </span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">DIRECTOR. EDITOR. BUILDER.</p>
          <h1 id="hero-title">
            KOJO
            <br />
            AKINE<span class="name-dot">.</span>
          </h1>
          <p class="japanese-name">
            <Text ja="小城 昭根" en="小城 昭根 / Kojo Akine" />
            <Text ja="映像 × テクノロジー" en="Film × Technology" />
          </p>
          <Text
            as="p"
            class="hero-promise"
            ja="心を動かす映像を。\nアイデアを、動くかたちに。"
            en="Stories that move people.\nIdeas brought to life."
          />
          <Text
            as="p"
            class="hero-description"
            ja="映像の企画・監督・編集から、AIを使った制作と開発まで。つくりたいものに、現場と技術の両方で応えます。"
            en="Direction, editing, AI visuals and development. Creative production and engineering, working together to bring your idea to life."
          />
          <div class="hero-links">
            <a class="button button-dark" href="#works">
              <Text ja="制作実績を見る" en="Explore my work" />
              <span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href="#contact">
              <Text ja="仕事を相談する" en="Discuss a project" />
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <a
          class="hero-feature"
          href="#featured"
          aria-label="EXILE LIVE TOUR 2025 — 制作詳細"
        >
          <div class="feature-image">
            <Image
              src={exile}
              alt="EXILE LIVE TOUR 2025に制作した、ネオンの街とクラシックカーのスクリーン映像"
              widths={[640, 960, 1440]}
              sizes="(max-width: 760px) 100vw, 58vw"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
            <span class="frame-corner top-left" aria-hidden="true"></span>
            <span class="frame-corner bottom-right" aria-hidden="true"></span>
            <span class="image-label">SELECTED WORK / 01</span>
            <span class="feature-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
          <div class="feature-caption">
            <div>
              <span class="eyebrow">LIVE VISUAL / 2025</span>
              <h2>
                EXILE LIVE TOUR
                <br />
                “THE REASON”
              </h2>
            </div>
            <Text
              class="feature-role"
              ja="スクリーン映像\nクリエイティブディレクション"
              en="Screen visuals\nCreative direction"
            />
          </div>
          <div class="feature-sticker" aria-hidden="true">
            FROM
            <br />
            IDEA TO
            <br />
            <em>IMPACT.</em>
          </div>
        </a>
      </div>
      <div class="proof-strip" aria-label="実績の概要">
        <div>
          <strong>
            50<span>+</span>
          </strong>
          <Text ja="2025年の映像制作" en="Video projects in 2025" />
        </div>
        <div>
          <strong>
            1M<span>+</span>
          </strong>
          <Text
            ja="YouTube・TikTok 各再生実績"
            en="Views on both YouTube & TikTok"
          />
        </div>
        <div>
          <strong>
            10<span>years</span>
          </strong>
          <Text ja="高校映画部での映像教育" en="Teaching film at high school" />
        </div>
        <a href="#works" class="proof-note">
          <Text
            ja="数字の先に、作品がある。"
            en="The work behind the numbers."
          />
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section id="works" class="section container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / SELECTED WORK</p>
          <Text as="h2" ja="つくってきたもの。" en="Selected work." />
        </div>
        <Text
          as="p"
          ja="映像の企画から、最後の1カットまで。\n案件ごとの担当範囲とともにご紹介します。"
          en="From the first idea to the final cut.\nSelected projects, with my role in each."
        />
      </div>
      <article id="featured" class="featured-project">
        <div
          class="gallery"
          role="region"
          aria-label="EXILE LIVE TOUR gallery"
          tabindex="0"
        >
          <div class="gallery-track" id="gallery-track">
            {gallery.map((item, i) => (
              <figure
                class="gallery-slide"
                aria-hidden={i > 0 ? 'true' : 'false'}
              >
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[640, 1280, 1920]}
                  sizes="(max-width: 760px) 100vw, 85vw"
                  format="webp"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
          <div class="gallery-controls" hidden>
            <span class="eyebrow">EXILE / SCREEN VISUAL</span>
            <div>
              <button type="button" id="gallery-prev" aria-label="前の画像">
                ←
              </button>
              <span id="gallery-status" role="status" aria-live="polite">
                01 / 04
              </span>
              <button type="button" id="gallery-next" aria-label="次の画像">
                →
              </button>
            </div>
          </div>
        </div>
        <div class="featured-description">
          <div>
            <p class="eyebrow">LIVE VISUAL / 2025</p>
            <h3>
              EXILE LIVE TOUR 2025
              <br />
              “THE REASON”
            </h3>
          </div>
          <div>
            <Text
              as="p"
              class="role"
              ja="担当：クリエイティブディレクション・コンセプトデザイン"
              en="Role: Creative direction / Concept design"
            />
            <Text
              as="p"
              ja="福岡ドーム公演「WON’T BE LONG」のスクリーン映像。コンセプトの企画立案からCG制作チームとの協働まで担当し、複数面の大型LEDスクリーンに展開する映像を制作しました。"
              en="Screen visuals for “WON’T BE LONG” at the Fukuoka dome show. I developed the visual concept and collaborated with the CG production team on visuals for the stage’s large, multi-panel LED screens."
            />
          </div>
        </div>
      </article>
      <div class="work-grid">
        {works.map((work, i) => (
          <article class="work-card">
            <a
              href={work.url}
              target="_blank"
              rel="noopener noreferrer"
              class="work-image-link"
            >
              <div class="work-image">
                {work.youtube ? (
                  <img
                    src={`https://img.youtube.com/vi/${work.youtube}/hqdefault.jpg`}
                    width="480"
                    height="360"
                    alt={work.title.ja}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={vfx}
                    alt="Blenderで制作したVFX動画"
                    widths={[640, 960]}
                    sizes="(max-width: 760px) 100vw, 45vw"
                    format="webp"
                    loading="lazy"
                  />
                )}
                <span class="work-index">
                  0{i + 2} / {work.category}
                </span>
                <span class="play-button" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div class="work-heading">
                <Text as="h3" {...work.title} />
                <span class="external-label">
                  <Text ja="作品を見る" en="View work" /> ↗
                </span>
              </div>
            </a>
            <Text as="p" class="role" {...work.role} />
            <Text as="p" class="work-description" {...work.description} />
          </article>
        ))}
      </div>
      <details class="more-work">
        <summary>
          <Text ja="その他の制作実績" en="More production credits" />
          <span aria-hidden="true">＋</span>
        </summary>
        <div class="credit-list">
          {otherWorks.map((work) => (
            <a href={work.url} target="_blank" rel="noopener noreferrer">
              <Text ja={work.title} en={work.en} />
              <Text ja={work.role} en={work.roleEn} />
              <span aria-hidden="true">↗</span>
            </a>
          ))}
          <div>
            <Text
              ja="全国算数・数学教育研究大会シンポジウム"
              en="National Mathematics Education Symposium"
            />
            <Text
              ja="撮影・配信・デザイン"
              en="Capture / Live streaming / Design"
            />
          </div>
        </div>
      </details>
    </section>

    <section id="skills" class="services-section section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / WHAT I CAN DO</p>
            <Text
              as="h2"
              ja="こんなとき、声をかけてください。"
              en="Where I can help."
            />
          </div>
        </div>
        <div class="services-grid">
          {services.map((service) => (
            <article class="service">
              <div class="service-top">
                <span>{service.number}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <p class="eyebrow">{service.label}</p>
              <Text as="h3" {...service.title} />
              <Text as="p" {...service.description} />
              <Text as="p" class="service-tools" {...service.items} />
              <a href="#contact" class="text-link">
                <Text ja="この内容で相談する" en="Let’s discuss it" />
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="lab" class="lab-section section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">03 / CREATIVE TECHNOLOGY</p>
            <Text
              as="h2"
              ja="映像の外にも、つくる力を。"
              en="Beyond the frame."
            />
          </div>
          <Text
            as="p"
            ja="Webエンジニアとして5年。\n映像制作の経験を、AIとソフトウェアにも。"
            en="Five years in web engineering.\nA filmmaker’s perspective on AI and software."
          />
        </div>
        <article class="creator-operations" aria-labelledby="creator-title">
          <div class="creator-intro">
            <span class="lab-tag">AI PRODUCTION / CREATOR BUSINESS</span>
            <h3 id="creator-title">
              <Text
                ja="生成して終わらない。制作から、運営まで。"
                en="Beyond generation. Production and creator operations."
              />
            </h3>
            <Text
              as="p"
              ja="DeviantArtで3アカウントを運営し、合計約2万人のフォロワーを獲得。ComfyUIでのワークフロー構築やMiniMaxの活用に加え、継続的な作品発信とコミッション制作に取り組んできました。"
              en="Operated three DeviantArt accounts with a combined following of just under 20,000. My experience spans building ComfyUI workflows, using MiniMax, publishing work consistently and producing commissions."
            />
          </div>
          <dl class="creator-metrics">
            <div>
              <dt>
                <Text ja="アカウント運営実績" en="Accounts operated" />
              </dt>
              <dd>3</dd>
            </div>
            <div>
              <dt>
                <Text
                  ja="FOLLOWERS / 合計フォロワー"
                  en="FOLLOWERS / Combined audience"
                />
              </dt>
              <dd>
                <span>≈20K</span>
              </dd>
            </div>
          </dl>
          <div class="creator-practice">
            <div>
              <span class="eyebrow">01 / WORKFLOW</span>
              <Text as="h3" ja="制作フローを組む" en="Build the workflow" />
              <Text
                as="p"
                ja="ComfyUIのノードベースのワークフローを構築。MiniMaxも活用し、AIを使った制作を継続的に実践。"
                en="Build node-based workflows in ComfyUI and use MiniMax as part of an ongoing AI production practice."
              />
            </div>
            <div>
              <span class="eyebrow">02 / PUBLISHING</span>
              <Text
                as="h3"
                ja="発信を続け、運営する"
                en="Publish and operate"
              />
              <Text
                as="p"
                ja="3アカウントで作品の発信・運営を経験。制作だけでなく、見てもらう場所を育てるところまで。"
                en="Experience publishing and operating across three accounts, developing an audience alongside the creative work."
              />
            </div>
            <div>
              <span class="eyebrow">03 / COMMISSIONS</span>
              <Text as="h3" ja="依頼を、作品にする" en="Create for a brief" />
              <Text
                as="p"
                ja="コミッションを継続的に受け、依頼に応じた作品を制作。自主制作と受注制作の両方を経験。"
                en="Regular commission work responding to individual requests, alongside self-directed creative production."
              />
            </div>
          </div>
          <Text
            as="p"
            class="creator-note"
            ja="フォロワー数は3アカウントの運営時の合計実績です。"
            en="Follower figures reflect the combined following achieved across the three accounts during their operation."
          />
        </article>
        <div class="lab-lead">
          <div>
            <span class="lab-tag">AI VISUAL EXPLORATION</span>
            <Text
              as="h3"
              ja="光も、質感も。\nワークフローから設計する。"
              en="Light. Texture.\nA workflow of my own."
            />
            <Text
              as="p"
              ja="ComfyUIによる自主制作のフードビジュアル。プロンプト設計からノード構築まで自作し、静止画と動画を生成しています。"
              en="An independent food visual series made with ComfyUI. Custom prompts and node workflows, from still images to motion."
            />
            <span class="eyebrow">COMFYUI / AI-GENERATED / PERSONAL WORK</span>
          </div>
          <Image
            src={steak}
            alt="AI生成の自主制作：湯気の立つステーキのフードビジュアル"
            widths={[640, 960]}
            sizes="(max-width: 760px) 100vw, 50vw"
            format="webp"
            loading="lazy"
          />
        </div>
        <div class="ai-stills">
          {[
            { image: kitchen, alt: 'AI生成：炎の上がる厨房' },
            { image: washoku, alt: 'AI生成：和食の俯瞰' },
            { image: caramel, alt: 'AI生成：キャラメルのデザート' },
            { image: cheesecake, alt: 'AI生成：バスクチーズケーキ' },
          ].map((item) => (
            <Image
              src={item.image}
              alt={item.alt}
              widths={[320, 640]}
              sizes="(max-width: 760px) 45vw, 22vw"
              format="webp"
              loading="lazy"
            />
          ))}
        </div>
        <details class="lab-details">
          <summary>
            <Text ja="AI生成動画を見る" en="Watch the AI motion studies" />
            <span aria-hidden="true">＋</span>
          </summary>
          <div class="ai-videos">
            {[
              { name: 'steak', label: 'AI生成動画：ステーキ' },
              { name: 'caramel', label: 'AI生成動画：キャラメル' },
              { name: 'cheese', label: 'AI生成動画：チーズ' },
            ].map((video) => (
              <video
                src={`/ai-art/ai-${video.name}.mp4`}
                poster={`/ai-art/ai-${video.name}-poster.jpg`}
                controls
                playsinline
                preload="none"
                aria-label={video.label}
              ></video>
            ))}
          </div>
        </details>
        <div class="build-grid">
          <article>
            <span class="eyebrow">01 / ON-SET TOOLS</span>
            <h3>ClapperLog</h3>
            <Text
              as="p"
              ja="映像制作現場向けの撮影記録アプリ。タイマー管理、シーン連番登録、CSV出力をひとつに。"
              en="A shooting log for film sets, combining timers, scene numbering and CSV export."
            />
            <a
              href="https://github.com/akine/clapperlog"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </article>
          <article>
            <span class="eyebrow">02 / PRODUCTION WORKFLOW</span>
            <h3>SceneScope</h3>
            <Text
              as="p"
              ja="脚本PDFからシーン分析・エレメント抽出を行うAI脚本解析ツール。開発中のプロジェクトです。"
              en="An AI script analysis tool for scene breakdowns and element extraction from screenplay PDFs. In development."
            />
            <span class="project-status">
              <Text ja="開発中" en="In development" />
            </span>
          </article>
          <article>
            <span class="eyebrow">03 / AUTOMATION</span>
            <Text as="h3" ja="3Dアセット制作フロー" en="3D asset pipeline" />
            <Text
              as="p"
              ja="AI画像生成、3D変換、Blenderでの最適化をつなぐ自作パイプライン。Roblox向けアセット制作を自動化。"
              en="A custom pipeline connecting AI image generation, 3D conversion and Blender optimization for Roblox assets."
            />
            <span class="project-status">AI / Blender / Python</span>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="section container about-section">
      <div class="about-portrait">
        <Image
          src={avatar}
          alt="小城昭根のプロフィール画像"
          widths={[320, 640]}
          sizes="(max-width: 760px) 160px, 280px"
          format="webp"
          loading="lazy"
        />
        <p class="eyebrow">KOJO AKINE / 小城 昭根</p>
      </div>
      <div class="about-copy">
        <p class="eyebrow">04 / ABOUT ME</p>
        <Text
          as="h2"
          ja="演出も、編集も、コードも。\n一本の線でつながっている。"
          en="Direction, editing, code.\nOne connected practice."
        />
        <Text
          as="p"
          ja="シナリオセンターで脚本を、ENBUゼミナール映画監督コース（2020年度）で演出を学びました。Webエンジニアとして5年の経験があり、Unreal Engine・Meta Quest 3によるVRトレーニングシステムも開発。現在は映像制作とAI・アプリ開発を手がけています。"
          en="I studied screenwriting at Scenario Center and directing at ENBU Seminar (2020). My background includes five years in web engineering and VR training system development with Unreal Engine and Meta Quest 3. Today I work across film production, AI and application development."
        />
        <Text
          as="p"
          ja="東京都立工芸高校の映画部では、外部講師として10年間指導。指導した生徒の作品がぴあフィルムフェスティバルに入選しました。自分でつくることも、誰かの「つくりたい」を支えることも、大切にしています。"
          en="I also spent ten years teaching film at Tokyo Metropolitan Kogei High School as an external instructor. A student film was selected for the PIA Film Festival. Making work and helping others make theirs are both central to my practice."
        />
        <div class="about-links">
          <a
            href="https://www.linkedin.com/in/akinechan/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
          <a
            href="https://github.com/akine"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
          <a
            href="https://note.com/akinechan"
            target="_blank"
            rel="noopener noreferrer"
          >
            note ↗
          </a>
        </div>
      </div>
    </section>

    <section id="process" class="section process-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">05 / HOW WE WORK</p>
            <Text
              as="h2"
              ja="まずは、話すところから。"
              en="It starts with a conversation."
            />
          </div>
        </div>
        <ol class="process-grid">
          <li>
            <span>01</span>
            <Text as="h3" ja="ご相談" en="Tell me about it" />
            <Text
              as="p"
              ja="内容・時期・予算を、分かる範囲でお知らせください。企画段階や募集ポジションのご相談も歓迎です。"
              en="Share the scope, timing and budget you know. Early ideas and opportunities to join your team are welcome."
            />
          </li>
          <li>
            <span>02</span>
            <Text as="h3" ja="進め方・お見積もり" en="Scope & estimate" />
            <Text
              as="p"
              ja="担当範囲、納期、費用、修正回数をすり合わせてから制作を始めます。"
              en="We agree on responsibilities, schedule, cost and revision rounds before production starts."
            />
          </li>
          <li>
            <span>03</span>
            <Text as="h3" ja="制作・納品" en="Make & deliver" />
            <Text
              as="p"
              ja="進捗を共有しながら制作。確認・修正を経て、ご希望の形式で納品します。"
              en="Regular progress updates, review and agreed revisions, then delivery in your preferred format."
            />
          </li>
        </ol>
        <div class="faq">
          <details>
            <summary>
              <Text
                ja="編集だけ・継続のお仕事も相談できますか？"
                en="Can you help with editing only or ongoing work?"
              />
              <span aria-hidden="true">＋</span>
            </summary>
            <Text
              as="p"
              ja="はい。編集のみ、制作チームへの参加、継続的な業務委託・アルバイトも歓迎です。担当業務や稼働日数をお知らせください。"
              en="Yes. Editing-only projects, joining production teams, ongoing freelance engagements and part-time roles are welcome. Tell me about the responsibilities and schedule."
            />
          </details>
          <details>
            <summary>
              <Text
                ja="予算や依頼内容がまだ決まっていません。"
                en="What if the budget or brief isn’t final yet?"
              />
              <span aria-hidden="true">＋</span>
            </summary>
            <Text
              as="p"
              ja="決まっていることだけで大丈夫です。目的や完成イメージを伺い、必要な工程と費用をご提案します。開始時期や短納期対応は、内容と稼働状況に合わせてご相談します。"
              en="Start with what you know. We can discuss the goal and propose a scope and estimate. Availability and rush deadlines are agreed based on the project and schedule."
            />
          </details>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section section">
      <div class="container">
        <div class="contact-top">
          <span class="eyebrow">HAVE SOMETHING IN MIND?</span>
          <span class="availability">
            <i aria-hidden="true"></i>
            <Text
              ja="単発・継続・チーム参加のご相談"
              en="Projects / Ongoing work / Team roles"
            />
          </span>
        </div>
        <Text
          as="h2"
          ja="次の「つくりたい」を、\n一緒に。"
          en="Let’s make\nwhat’s next."
        />
        <div class="contact-bottom">
          <div>
            <Text
              as="p"
              ja="映像制作、AI活用、開発のこと。\n依頼内容が固まっていなくても大丈夫です。"
              en="Film, AI or development.\nA rough idea is a good place to start."
