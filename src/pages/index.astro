  <!-- Language Toggle Script -->
  <script>
    const langToggle = document.getElementById('lang-toggle');
    let currentLang = 'ja';

    // 初期表示を日本語に
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-en][data-ja]').forEach(el => {
        const text = el.getAttribute('data-ja');
        if (text) {
          el.textContent = text;
        }
      });
    });

    langToggle?.addEventListener('click', () => {
      currentLang = currentLang === 'ja' ? 'en' : 'ja';
      langToggle.textContent = currentLang === 'ja' ? 'English' : '日本語';
      
      document.querySelectorAll('[data-en][data-ja]').forEach(el => {
        const text = el.getAttribute(`data-${currentLang}`);
        if (text) {
          el.textContent = text;
        }
      });
    });

    // EXILE Gallery Slider
    (() => {
      const slides = document.getElementById('exile-slides');
      const dots = document.querySelectorAll('.exile-dot');
      const prev = document.getElementById('exile-prev');
      const next = document.getElementById('exile-next');
      if (!slides) return;
      let current = 0;
      const total = dots.length;
      
      const goTo = (i: number) => {
        current = ((i % total) + total) % total;
        slides.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, idx) => {
          (d as HTMLElement).style.opacity = idx === current ? '0.9' : '0.4';
        });
      };
      
      prev?.addEventListener('click', () => goTo(current - 1));
      next?.addEventListener('click', () => goTo(current + 1));
      dots.forEach(d => d.addEventListener('click', () => goTo(Number((d as HTMLElement).dataset.index))));
      
      // Touch swipe support
      let startX = 0;
      slides.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
      slides.addEventListener('touchend', (e) => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
      });
      
      // Auto-advance every 5s
      let timer = setInterval(() => goTo(current + 1), 5000);
      slides.parentElement?.addEventListener('mouseenter', () => clearInterval(timer));
      slides.parentElement?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 5000); });
    })();

    // 🥚 Easter Egg
    const avatar = document.getElementById('avatar');
    let clickCount = 0;
    let clickTimer: ReturnType<typeof setTimeout> | null = null;
    const messages = [
      '🎬 Action!', '📹 Rolling!', '✂️ Good cut!', '🎥 Wrap!', '💡',
      '🎮 GG!', '🐂 アリスター！', '🥋 ジェイミー！', '🦞', '🍻', '💖', '✨',
      '(´・ω・｀)', '( ˘ω˘ )', '٩( \'ω\' )و', '🦐 エビじゃないよ',
      'ちゅむ 💕', '(´∀`) ぬるぽ'
    ];

    // 四方八方からの曲線パターン
    const getRandomPath = (rect: DOMRect) => {
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const r = rect.width / 2;
      
      const patterns = [
        // 右上へ「ノ」
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 60, y: cy - 20 }, end: { x: cx + r + 40, y: cy - r - 40 } },
        // 左上へ逆「ノ」
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 60, y: cy - 20 }, end: { x: cx - r - 40, y: cy - r - 40 } },
        // 右下へ
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 60, y: cy + 20 }, end: { x: cx + r + 50, y: cy + r + 30 } },
        // 左下へ
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 60, y: cy + 20 }, end: { x: cx - r - 50, y: cy + r + 30 } },
        // 真上へ
        { start: { x: cx, y: cy - r * 0.5 }, mid: { x: cx + 30, y: cy - r - 30 }, end: { x: cx, y: cy - r - 60 } },
        // 真上へ（逆カーブ）
        { start: { x: cx, y: cy - r * 0.5 }, mid: { x: cx - 30, y: cy - r - 30 }, end: { x: cx, y: cy - r - 60 } },
        // 右へ
        { start: { x: cx + r * 0.5, y: cy }, mid: { x: cx + r + 40, y: cy - 30 }, end: { x: cx + r + 80, y: cy } },
        // 左へ
        { start: { x: cx - r * 0.5, y: cy }, mid: { x: cx - r - 40, y: cy - 30 }, end: { x: cx - r - 80, y: cy } },
      ];
      
      return patterns[Math.floor(Math.random() * patterns.length)];
    };

    const spawnEasterEgg = (forceMsg?: string, targetPos?: {x: number, y: number}) => {
      const rect = avatar!.getBoundingClientRect();
      const msg = forceMsg || messages[Math.floor(Math.random() * messages.length)];
      const path = getRandomPath(rect);
      
      // ｶﾞｯの場合はぬるぽの位置に被せる
      const isGatsu = msg === '⊂彡☆))Д´) ｶﾞｯ';
      const endPos = targetPos || path.end;
      
      const toast = document.createElement('div');
      toast.textContent = msg;
      toast.style.cssText = `
        position: fixed;
        left: ${path.start.x}px;
        top: ${path.start.y}px;
        transform: translate(-50%, -50%) scale(0);
        background: ${isGatsu ? '#ef4444' : 'white'};
        color: ${isGatsu ? 'white' : '#334155'};
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 600;
        z-index: ${isGatsu ? 41 : 40};
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        border: 2px solid ${isGatsu ? '#dc2626' : '#e2e8f0'};
        white-space: nowrap;
        pointer-events: none;
      `;

      document.body.appendChild(toast);
      
      // ぬるぽが出たら自動でｶﾞｯ（少しズラして被せる）
      if (msg === '(´∀`) ぬるぽ') {
        const gatsuPos = { x: endPos.x + 15, y: endPos.y - 20 };
        setTimeout(() => spawnEasterEgg('⊂彡☆))Д´) ｶﾞｯ', gatsuPos), 400);
      }

      // スッと出て、止まって見せて、ふわっと消える
      toast.animate([
        { 
          left: `${path.start.x}px`, 
          top: `${path.start.y}px`, 
          transform: 'translate(-50%, -50%) scale(0.5)', 
          opacity: 0,
          offset: 0
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1.05)', 
          opacity: 1,
          offset: 0.15
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1)', 
          opacity: 1,
          offset: 0.25
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y}px`, 
          transform: 'translate(-50%, -50%) scale(1)', 
          opacity: 1,
          offset: 0.75
        },
        { 
          left: `${endPos.x}px`, 
          top: `${endPos.y - 15}px`, 
          transform: 'translate(-50%, -50%) scale(0.9)', 
          opacity: 0,
          offset: 1
        }
      ], {
        duration: 2500,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      }).onfinish = () => toast.remove();
    };

    avatar?.addEventListener('click', () => {
      clickCount++;
      
      if (clickTimer) clearTimeout(clickTimer);
      clickTimer = setTimeout(() => { clickCount = 0; }, 2000);

      // 5回ごとに発動（5, 10, 15, ...）- 連打OK、同時に複数出る
      if (clickCount % 5 === 0) {
        // 少しランダムな遅延で同時感を出す
        setTimeout(() => spawnEasterEgg(), Math.random() * 100);
      }
    });
  </script>
</Layout>
