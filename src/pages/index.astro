---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import avatarImage from '../assets/avatar.png';
import exileTourThumb from '../assets/exile-tour-thumb.jpg';
import exileTourNeonCity from '../assets/exile-tour-neon-city.jpg';
import exileTourTitle from '../assets/exile-tour-title.jpg';
import exileTourWontbelong from '../assets/exile-tour-wontbelong.jpg';
import tiktokVfxImage from '../assets/tiktok-vfx.jpg';
---

<Layout title="Kojo Akine | Creative Director & Filmmaker">
  <!-- Navigation -->
  <nav class="fixed top-0 w-full bg-white/80 backdrop-blur-md z-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold text-slate-800">KA</a>
      <div class="flex gap-6 items-center">
        <div class="flex gap-8 text-sm">
          <a href="#about" class="text-slate-500 hover:text-slate-800 transition" data-en="About" data-ja="概要">About</a>
          <a href="#skills" class="text-slate-500 hover:text-slate-800 transition" data-en="Skills" data-ja="スキル">Skills</a>
          <a href="#works" class="text-slate-500 hover:text-slate-800 transition" data-en="Works" data-ja="実績">Works</a>
          <a href="#process" class="text-slate-500 hover:text-slate-800 transition" data-en="Flow" data-ja="流れ">Flow</a>
          <a href="#contact" class="text-slate-500 hover:text-slate-800 transition" data-en="Contact" data-ja="連絡先">Contact</a>
        </div>
        <button id="lang-toggle" class="text-sm bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-full transition">
          English
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="min-h-screen flex items-center justify-center px-6 pt-20 relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="hero-blob absolute -top-24 -left-24 w-96 h-96 rounded-full bg-sky-200/50 blur-3xl"></div>
      <div class="hero-blob hero-blob-2 absolute top-1/3 -right-32 w-[28rem] h-[28rem] rounded-full bg-pink-200/45 blur-3xl"></div>
      <div class="hero-blob hero-blob-3 absolute -bottom-32 left-1/4 w-96 h-96 rounded-full bg-amber-200/40 blur-3xl"></div>
    </div>
    <div class="max-w-4xl text-center relative">
      <div id="avatar-card" class="relative inline-flex group mb-8 [perspective:900px]">
        <span aria-hidden="true" class="pointer-events-none absolute -inset-5 rounded-full bg-sky-300/35 blur-2xl opacity-0 scale-95 transition duration-300 ease-out group-hover:opacity-100 group-hover:scale-100"></span>
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 z-40 rounded-full opacity-0 transition duration-200 ease-out group-hover:opacity-100" style="background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(15,23,42,0.24), rgba(15,23,42,0) 45%);"></span>
        <Image src={avatarImage} alt="Kojo Akine" id="avatar" class="w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto shadow-lg border-4 border-white object-cover cursor-pointer select-none relative z-50 transition-shadow duration-300 ease-out will-change-transform group-hover:shadow-2xl" style="transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--sc, 1));" widths={[160, 320]} sizes="(min-width: 768px) 160px, 128px" format="webp" loading="eager" fetchpriority="high" />
      </div>
      <h1 class="text-5xl md:text-7xl font-bold text-slate-800 mb-8">
        <span data-en="Kojo Akine" data-ja="小城 昭根">Kojo Akine</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-600 mb-4 max-w-2xl mx-auto" data-en="I used to create short dramas. Now I build things with AI." data-ja="ショートドラマを作っていた経験を活かして、いまはAIとものづくりをしています。">
        ショートドラマを作っていた経験を活かして、いまはAIとものづくりをしています。
      </p>
      <p class="text-xl md:text-2xl text-slate-600 mb-8 max-w-2xl mx-auto" data-en="I built this site with AI too." data-ja="このサイトもAIと一緒に作りました。">
        このサイトもAIと一緒に作りました。
      </p>
      <p class="text-slate-500 mb-12 max-w-xl mx-auto">
        <span data-en="50+ video projects delivered. EXILE dome tour screen visuals." data-ja="50本以上の映像プロジェクト。EXILEドームツアーのスクリーン映像。">50本以上の映像プロジェクト。EXILEドームツアーのスクリーン映像。</span><br>
        <span data-en="YouTube & TikTok: 1M+ views each. 10 years teaching film." data-ja="YouTube・TikTok各100万再生。映像教育10年。">YouTube・TikTok各100万再生。映像教育10年。</span>
      </p>
      <div class="flex gap-4 justify-center">
        <a href="#contact" class="bg-sky-500 hover:bg-sky-400 text-white px-8 py-3 rounded-full font-medium transition" data-en="Book a Project" data-ja="案件を相談する">
          Book a Project
        </a>
        <a href="#works" class="border border-slate-400 hover:border-slate-600 text-slate-700 px-8 py-3 rounded-full font-medium transition" data-en="See Case Results" data-ja="成果を見る">
          See Case Results
        </a>
      </div>
      <p class="text-sm text-slate-500 mt-6" data-en="Creative Direction / Video Production / AI Visual Development" data-ja="クリエイティブディレクション / 映像制作 / AIビジュアル開発">
        クリエイティブディレクション / 映像制作 / AIビジュアル開発
      </p>
      <p class="text-sm text-slate-400 mt-3">
        <span data-en="Free consultation • Reply within 24 hours • Remote worldwide" data-ja="相談無料 • 原則24時間以内に返信 • フルリモート対応">相談無料 • 原則24時間以内に返信 • フルリモート対応</span>
      </p>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-32 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-slate-800 mb-16 text-center" data-en="About" data-ja="概要">About</h2>
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl font-semibold text-slate-800 mb-4" data-en="Background" data-ja="経歴">Background</h3>
          <p class="text-slate-600 leading-relaxed mb-6" data-en="Studied screenwriting at Scenario Center and directing at ENBU Seminar Film Director Course (2020). For 10 years, I've been teaching film production at Tokyo Metropolitan Kogei High School as an official external instructor commissioned by Tokyo Metropolitan Government. My students' work was selected for PIA Film Festival (22 out of 795 submissions)." data-ja="シナリオセンターで脚本を、ENBUゼミナール映画監督コース（2020年度）で演出を学ぶ。10年にわたり東京都立工芸高校で映画部の外部講師として指導（東京都公式委嘱）。指導した生徒の作品は、ぴあフィルムフェスティバルで入選（795作品中22作品）。">
            シナリオセンターで脚本を、ENBUゼミナール映画監督コース（2020年度）で演出を学ぶ。10年にわたり東京都立工芸高校で映画部の外部講師として指導（東京都公式委嘱）。指導した生徒の作品は、ぴあフィルムフェスティバルで入選（795作品中22作品）。
          </p>
          <p class="text-slate-600 leading-relaxed mb-6" data-en="In 2025, I directed and edited 50+ short dramas for YouTube, achieving 1M+ views. Also produced VFX content on TikTok with 1M+ views. Worked with major artists including Ado's Phantom Theta project. On DeviantArt, I regularly publish AI art that balances allure and beauty for audiences around the world (ask me about it when we meet)." data-ja="2025年には、YouTubeで50本以上のショートドラマを監督・編集し、100万再生を達成。TikTokでもVFXコンテンツで100万再生を突破。Adoプロデュースのファントムシータなど大型案件も担当。DeviantArtでは、艶やかさと美しさを両立したAIアートを継続的に発表し、世界中のオーディエンスを楽しませています（どんな作品かは、会ったときにでも聞いてください）。">
            2025年には、YouTubeで50本以上のショートドラマを監督・編集し、100万再生を達成。TikTokでもVFXコンテンツで100万再生を突破。Adoプロデュースのファントムシータなど大型案件も担当。DeviantArtでは、艶やかさと美しさを両立したAIアートを継続的に発表し、世界中のオーディエンスを楽しませています（どんな作品かは、会ったときにでも聞いてください）。
          </p>
          <p class="text-slate-600 leading-relaxed" data-en="Web Engineer for 5 years (Rails, React), then VR training systems (Unreal Engine, Meta Quest 3). Now merging creative direction with AI. Beyond video production, also builds bots and apps with AI — turning ideas into reality from concept to launch." data-ja="Webエンジニア5年（Rails, React）、VRトレーニングシステム開発（Unreal Engine, Meta Quest 3）を経て、現在はクリエイティブディレクションとAI活用を融合。映像制作に加えて、AIを使ったBot開発やアプリ制作も手がけ、「作りたいもの」を企画から実装まで一貫して形にする。">
            Webエンジニア5年（Rails, React）、VRトレーニングシステム開発（Unreal Engine, Meta Quest 3）を経て、現在はクリエイティブディレクションとAI活用を融合。映像制作に加えて、AIを使ったBot開発やアプリ制作も手がけ、「作りたいもの」を企画から実装まで一貫して形にする。
          </p>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-slate-800 mb-4" data-en="What I Bring" data-ja="強み">What I Bring</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-sky-500 mt-1">▸</span>
              <span class="text-slate-600"><strong class="text-slate-800" data-en="Creative Direction" data-ja="クリエイティブ・ディレクション">Creative Direction</strong> — <span data-en="EXILE dome tour visuals. Teams of 10+ staff & 10+ actors." data-ja="EXILEドームツアーの映像演出。スタッフ10人・演者10人超のチームを統括。">EXILEドームツアーの映像演出。スタッフ10人・演者10人超のチームを統括。</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 mt-1">▸</span>
              <span class="text-slate-600"><strong class="text-slate-800" data-en="1M+ Views Content" data-ja="100万再生を作れる">1M+ Views Content</strong> — <span data-en="YouTube & TikTok, both 1M+ views. Content designed to perform." data-ja="YouTube・TikTok両方で100万再生突破。数字を出すコンテンツ設計。">YouTube・TikTok両方で100万再生突破。数字を出すコンテンツ設計。</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 mt-1">▸</span>
              <span class="text-slate-600"><strong class="text-slate-800" data-en="Builds with AI" data-ja="AIで何でも形にする">Builds with AI</strong> — <span data-en="Video production, bot development, apps, websites — anything, built as a pair with AI." data-ja="映像制作もBot開発もアプリもサイトも。AIとペアで、思いついたら作れる。">映像制作もBot開発もアプリもサイトも。AIとペアで、思いついたら作れる。</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 mt-1">▸</span>
              <span class="text-slate-600"><strong class="text-slate-800" data-en="Unreasonably Fast" data-ja="異常に速い">Unreasonably Fast</strong> — <span data-en="Phantom Theta (Ado): 3-day turnaround. Small team × AI × tech for large-scale projects." data-ja="ファントムシータ（Ado）3日納品。少人数×AI×技術力で大規模案件に対応。">ファントムシータ（Ado）3日納品。少人数×AI×技術力で大規模案件に対応。</span></span>
            </li>
          </ul>
        </div>
      </div>
      
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="py-32 px-6 bg-slate-100">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-slate-800 mb-16 text-center" data-en="Skills" data-ja="スキル">Skills</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Create -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="text-4xl mb-4">🎬</div>
          <h3 class="text-xl font-semibold text-slate-800 mb-4" data-en="Create" data-ja="つくる">つくる</h3>
          <ul class="space-y-2 text-slate-600">
            <li data-en="• Dome tour screen visuals" data-ja="• ドームツアー映像演出">• ドームツアー映像演出</li>
            <li data-en="• 50+ short dramas" data-ja="• ショートドラマ50本+">• ショートドラマ50本+</li>
            <li data-en="• 1M+ view content" data-ja="• 100万再生コンテンツ">• 100万再生コンテンツ</li>
            <li data-en="• VFX / Motion Graphics" data-ja="• VFX / モーショングラフィックス">• VFX / モーショングラフィックス</li>
          </ul>
        </div>
        <!-- Build with AI -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="text-4xl mb-4">🤖</div>
          <h3 class="text-xl font-semibold text-slate-800 mb-4" data-en="Build with AI" data-ja="AIと組む">AIと組む</h3>
          <ul class="space-y-2 text-slate-600">
            <li data-en="• Concept to deployment, developed as a pair with AI" data-ja="• 企画から実装までAIとペアで開発">• 企画から実装までAIとペアで開発</li>
            <li data-en="• Bots, apps, websites at production speed" data-ja="• Bot・アプリ・Webサイトを量産">• Bot・アプリ・Webサイトを量産</li>
            <li data-en="• Custom production pipelines" data-ja="• 制作パイプラインを自分で設計・構築">• 制作パイプラインを自分で設計・構築</li>
            <li data-en="• AI image generation workflow" data-ja="• AI画像生成ワークフロー">• AI画像生成ワークフロー</li>
            <li data-en="• Alluring AI art, published regularly on DeviantArt" data-ja="• 艶のあるAIアートをDeviantArtで継続発表">• 艶のあるAIアートをDeviantArtで継続発表</li>
          </ul>
        </div>
        <!-- Everything Connects -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-semibold text-slate-800 mb-4" data-en="Everything Connects" data-ja="全部つながる">全部つながる</h3>
          <ul class="space-y-2 text-slate-600">
            <li data-en="• Video, design, and dev — speaks every language" data-ja="• 映像もデザインも開発もわかるから話が早い">• 映像もデザインも開発もわかるから話が早い</li>
            <li data-en="• Concept to delivery, all under one roof" data-ja="• 企画から納品までワンストップで対応可能">• 企画から納品までワンストップで対応可能</li>
            <li data-en="• Adapts to team or solo, whatever the project needs" data-ja="• チームでもソロでも最適な形で動ける">• チームでもソロでも最適な形で動ける</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Works -->
  <section id="works" class="py-32 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-slate-800 mb-16 text-center" data-en="Works" data-ja="実績">Works</h2>
      
      <!-- Highlight Numbers -->
      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <div class="text-center p-8 bg-gradient-to-br from-sky-100 to-white rounded-2xl border border-sky-200">
          <p class="text-5xl font-bold text-sky-600 mb-2">1M+</p>
          <p class="text-slate-600" data-en="YouTube Views" data-ja="YouTube再生">YouTube Views</p>
        </div>
        <div class="text-center p-8 bg-gradient-to-br from-pink-100 to-white rounded-2xl border border-pink-200">
          <p class="text-5xl font-bold text-pink-600 mb-2">1M+</p>
          <p class="text-slate-600" data-en="TikTok VFX Views" data-ja="TikTok VFX再生">TikTok VFX Views</p>
        </div>
        <div class="text-center p-8 bg-gradient-to-br from-amber-100 to-white rounded-2xl border border-amber-200">
          <p class="text-5xl font-bold text-amber-600 mb-2">10</p>
          <p class="text-slate-600" data-en="Years Teaching Film" data-ja="年間映像教育">Years Teaching Film</p>
        </div>
      </div>

      <!-- EXILE LIVE TOUR - Featured -->
      <div class="mb-16">
        <h3 class="text-xl font-semibold text-slate-800 mb-8" data-en="Featured" data-ja="注目作品">Featured</h3>
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-md mb-8">
          <!-- Image Gallery -->
          <div class="relative">
            <div id="exile-gallery" class="overflow-hidden">
              <div id="exile-slides" class="flex transition-transform duration-500 ease-out">
                <Image src={exileTourThumb} alt="EXILE LIVE TOUR 2025 Screen Visual" class="w-full aspect-video object-cover flex-shrink-0" widths={[768, 1280, 1920]} sizes="(max-width: 768px) 100vw, 1280px" format="webp" loading="eager" />
                <Image src={exileTourNeonCity} alt="Neon City Visual" class="w-full aspect-video object-cover flex-shrink-0" widths={[768, 1280, 1920]} sizes="(max-width: 768px) 100vw, 1280px" format="webp" loading="lazy" />
                <Image src={exileTourTitle} alt="Title Visual" class="w-full aspect-video object-cover flex-shrink-0" widths={[768, 1280, 1920]} sizes="(max-width: 768px) 100vw, 1280px" format="webp" loading="lazy" />
                <Image src={exileTourWontbelong} alt="WON'T BE LONG Visual" class="w-full aspect-video object-cover flex-shrink-0" widths={[768, 1280, 1920]} sizes="(max-width: 768px) 100vw, 1280px" format="webp" loading="lazy" />
              </div>
            </div>
            <!-- Gallery Controls -->
            <button id="exile-prev" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center transition text-lg">‹</button>
            <button id="exile-next" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center transition text-lg">›</button>
            <!-- Dots -->
            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
              <button class="exile-dot w-2 h-2 rounded-full bg-white/90 transition" data-index="0"></button>
              <button class="exile-dot w-2 h-2 rounded-full bg-white/40 transition" data-index="1"></button>
              <button class="exile-dot w-2 h-2 rounded-full bg-white/40 transition" data-index="2"></button>
              <button class="exile-dot w-2 h-2 rounded-full bg-white/40 transition" data-index="3"></button>
            </div>
            <span class="absolute top-3 right-3 bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded" data-en="DOME TOUR" data-ja="ドームツアー">DOME TOUR</span>
          </div>
          <div class="p-8">
            <h4 class="text-xl text-slate-800 font-bold mb-2">EXILE LIVE TOUR 2025 "THE REASON"</h4>
            <p class="text-sky-600 font-medium mb-3" data-en="Screen Visual — Creative Direction & Concept Design" data-ja="スクリーン映像 — クリエイティブディレクション & コンセプトデザイン">Screen Visual — Creative Direction & Concept Design</p>
            <p class="text-slate-600 text-sm leading-relaxed" data-en="Creative direction and concept design for the screen visuals of 'WON'T BE LONG' at Fukuoka PayPay Dome. Led the visual concept from ideation through production, collaborating with the CG team to deliver immersive stage graphics for a dome-scale live performance." data-ja="福岡PayPayドーム公演『WON'T BE LONG』のスクリーン映像におけるクリエイティブディレクションおよびコンセプトデザイン。映像コンセプトの企画立案からCG制作チームとの協働まで一貫して担当し、ドーム規模のライブパフォーマンスに没入感のあるステージグラフィックスを実現。">
              福岡PayPayドーム公演『WON'T BE LONG』のスクリーン映像におけるクリエイティブディレクションおよびコンセプトデザイン。映像コンセプトの企画立案からCG制作チームとの協働まで一貫して担当し、ドーム規模のライブパフォーマンスに没入感のあるステージグラフィックスを実現。
            </p>
            <p class="text-slate-400 text-xs mt-3" data-en="Produced for the large LED screens on the dome stage. Displayed across multiple screen panels in the venue." data-ja="ドームステージの大型LEDスクリーン向けに制作。会場では複数面のスクリーンに映し出されます。">
              ドームステージの大型LEDスクリーン向けに制作。会場では複数面のスクリーンに映し出されます。
            </p>
          </div>
        </div>
      </div>

      <!-- Videos -->
      <div class="mb-16">
        <h3 class="text-xl font-semibold text-slate-800 mb-8" data-en="Videos" data-ja="映像作品">Videos</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="https://youtu.be/sdFzPconxMU" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-2xl overflow-hidden border border-slate-200 hover:border-sky-400 hover:shadow-lg transition">
            <div class="aspect-video bg-slate-100 relative overflow-hidden">
              <img src="https://img.youtube.com/vi/sdFzPconxMU/maxresdefault.jpg" alt="Short Drama" class="w-full h-full object-cover group-hover:scale-105 transition" />
              <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                <span class="text-6xl text-white">▶</span>
              </div>
            </div>
            <div class="p-6">
