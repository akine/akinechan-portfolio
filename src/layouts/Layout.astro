---
import '../styles/global.css'

interface Props {
  title: string;
}

const { title } = Astro.props;
const siteUrl = 'https://akinechan.com';
const description = '小城昭根（Kojo Akine）| 映像ディレクター・編集者。EXILEドームツアー映像演出、Adoプロデュース案件、YouTube・TikTok各100万再生。映像編集からAI活用の制作フロー構築まで、相談無料・フルリモート対応。';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kojo Akine',
  alternateName: '小城昭根',
  url: siteUrl,
  jobTitle: 'Creative Director & Filmmaker',
  description,
  sameAs: [
    'https://www.linkedin.com/in/akinechan/',
    'https://github.com/akine',
    'https://x.com/akinecool',
    'https://www.instagram.com/akinex',
    'https://note.com/akinechan',
    'https://sizu.me/akine'
  ]
};
const personSchemaJson = JSON.stringify(personSchema);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="小城昭根 (Akine Kojo)" />
    <meta name="theme-color" content="#0f172a" />
    
    <!-- Canonical -->
    <link rel="canonical" href={siteUrl} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="小城昭根 | クリエイティブディレクター・映像作家" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="小城昭根 ポートフォリオ" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@akinecool" />
    <meta name="twitter:creator" content="@akinecool" />
    <meta name="twitter:title" content="小城昭根 | クリエイティブディレクター・映像作家" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={personSchemaJson} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
